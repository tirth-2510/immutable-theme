        "support.function.builtin",
        "support.variable"
      ],
      "settings": {
        "foreground": "#ADE83D"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
