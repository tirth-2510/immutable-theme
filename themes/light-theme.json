        "support.type",
        "support.type.primitive",
        "support.type.builtin",
        "storage.type.primitive",
        "entity.name.type.primitive",
        "support.class"
      ],
      "settings": {
        "foreground": "#3ED2FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Built-in functions (sum, round, len...)",
