        "foreground": "#FF9D4D"
      }
    },
    {
      "name": "Numbers, booleans, language constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "language.constant",
        "variable.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#C77DFF"
      }
    },
    {
      "name": "Other constants",
      "scope": [
        "constant.other",
        "constant.character",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#C77DFF"
      }
    },
    {
      "name": "HTML/XML tags",
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#00D1D1"
      }
    },
    {
      "name": "HTML/JSX attribute names",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#FFD24D"
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "support.type.property-name.less"
      ],
      "settings": {
        "foreground": "#00D1D1"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.name.tag.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#FFD24D"
      }
    },
    {
      "name": "CSS values / units",
      "scope": [
        "support.constant.property-value.css",
