  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#787E75",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Docblock keywords / tags",
      "scope": [
        "comment.block.documentation keyword",
        "comment.block.documentation storage.type.class"
      ],
      "settings": {
        "foreground": "#989E95",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables & plain identifiers",
      "scope": [
        "variable",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#F0F0EC"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#BBBBBB",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Object properties / attribute access",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#BBBBBB"
      }
    },
    {
      "name": "This / self",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#F0F0EC",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords, imports, operators",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.other",
        "storage.type.function",
        "storage.modifier.async",
        "storage.modifier",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#00D1D1"
      }
    },
    {
      "name": "Flow-breaking keywords (return, raise, yield, break, continue, pass, throw)",
      "scope": [
        "keyword.control.flow",
        "keyword.control.flow.return",
        "keyword.control.return",
        "keyword.other.return",
        "keyword.control.trycatch",
        "keyword.control.exception",
        "keyword.control.flow.throw",
        "keyword.control.flow.python"
      ],
      "settings": {
        "foreground": "#FF3D5C"
      }
    },
    {
      "name": "Storage (var/let/const/def/class/function keyword itself)",
      "scope": [
        "storage"
      ],
      "settings": {
        "foreground": "#00D1D1"
      }
    },
    {
      "name": "Storage type",
      "scope": [
        "storage.type"
      ],
      "settings": {
        "foreground": "#00D1D1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operators & punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments",
        "punctuation.definition.block",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#D6D6D0"
      }
    },
    {
      "name": "Function & method definitions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "entity.name.function.member",
        "meta.method.declaration entity.name.function",
        "meta.definition.method entity.name.function",
        "meta.function.method entity.name.function",
        "meta.method entity.name.function",
        "entity.name.function.member.js",
        "entity.name.function.member.ts",
        "meta.class entity.name.function"
      ],
      "settings": {
        "foreground": "#FFD24D"
      }
    },
    {
      "name": "Classes, types & namespaces",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.namespace",
        "entity.name.type.module",
        "meta.class entity.name.type"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Inherited class",
      "scope": [
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Decorators / annotations / attributes-macros",
      "scope": [
        "meta.decorator",
        "meta.decorator entity.name.function",
